   ],
   "source": [
    "a = int(input('请输入第一个数字：'))\n",
    "b = int(input('请输入第二个数字：'))\n",
    "\n",
    "# 条件判断 当第二个数为0时提示：\"不能除以零\"\n",
    "if b == 0:\n",
    "    print('被除数不可为 0 ！！！')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "63df7505-00db-40f5-8a01-4f439d94b7e7",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "和： 9 \n",
      " 差： 5 \n",
      " 乘积： 14 \n",
      " 商： 3.5 \n",
      " 整除得： 3 \n",
      " 余： 1 \n",
      " 幂： 49\n"
     ]
    }
   ],
   "source": [
    "# 打印输出结果\n",
    "print('和：', a + b, '\\n', '差：', a - b, '\\n', '乘积：', a * b, '\\n', '商：', a / b, '\\n', '整除得：', a // b, '\\n', '余：', a % b, '\\n', '幂：', a ** b)"
   ]
  }
 ],
